#!/usr/bin/env bash

set -u

VERSION="0.1.0"
UNIT="centos10-kde6-shell.service"
STATE_DIR="${CENTOS10_KDE6_STATE_DIR:-$HOME/.centos10-kde6}"
LOG_FILE="$STATE_DIR/session.log"
OLD_KWIN_DROPIN="$HOME/.config/systemd/user/plasma-kwin_wayland.service.d/centos10-kde6.conf"

mkdir -p "$STATE_DIR"

ok()   { printf '\033[1;32m[OK]\033[0m %s\n' "$*"; }
info() { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }

windows_host() {
    if [[ -n "${X410_HOST:-}" ]]; then
        printf '%s\n' "$X410_HOST"
        return
    fi

    local host=""
    host="$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')"
    if [[ -z "$host" && -r /etc/resolv.conf ]]; then
        host="$(awk '/^nameserver[[:space:]]+/ {print $2; exit}' /etc/resolv.conf)"
    fi
    printf '%s\n' "$host"
}

setup_environment() {
    local host
    host="$(windows_host)"
    if [[ -z "$host" ]]; then
        err "Kan inte hitta Windows/X410-adressen."
        err "Prova: X410_HOST=<Windows-IP> centos10-kde6 start"
        return 1
    fi

    export DISPLAY="${host}:0.0"

    # Plasma Shell is rendered by X410. Ordinary applications keep using the
    # WSLg Wayland compositor, which is the stable combination shown by the
    # working CentOS desktop.
    export WAYLAND_DISPLAY=wayland-0
    unset WAYLAND_SOCKET

    export XDG_SESSION_TYPE=wayland
    export XDG_CURRENT_DESKTOP=KDE
    export XDG_SESSION_DESKTOP=KDE
    export DESKTOP_SESSION=plasma
    export KDE_FULL_SESSION=true
    export KDE_SESSION_VERSION=6
    export QT_QPA_PLATFORM='wayland;xcb'
    export GDK_BACKEND='wayland,x11'
    export MOZ_ENABLE_WAYLAND=1
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"

    if [[ -S "$XDG_RUNTIME_DIR/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    fi

    if [[ -S /mnt/wslg/PulseServer ]]; then
        export PULSE_SERVER=unix:/mnt/wslg/PulseServer
    fi
}

x410_reachable() {
    if command -v xdpyinfo >/dev/null 2>&1; then
        timeout 5 xdpyinfo >/dev/null 2>&1
    elif command -v xset >/dev/null 2>&1; then
        timeout 5 xset q >/dev/null 2>&1
    else
        local host="${DISPLAY%%:*}"
        timeout 3 bash -c "exec 3<>/dev/tcp/${host}/6000" >/dev/null 2>&1
    fi
}

session_running() {
    systemctl --user is-active --quiet "$UNIT" 2>/dev/null &&
        pgrep -u "$(id -u)" -x plasmashell >/dev/null 2>&1
}

stop_display_manager() {
    local active="inactive"
    local enabled="disabled"
    active="$(systemctl is-active sddm.service 2>/dev/null || true)"
    enabled="$(systemctl is-enabled sddm.service 2>/dev/null || true)"

    if [[ "$active" != "active" && "$enabled" == "disabled" ]]; then
        return 0
    fi

    info "Stänger av SDDM som annars konkurrerar med WSL-sessionen ..."
    if sudo -n systemctl disable --now sddm.service >/dev/null 2>&1; then
        return 0
    fi

    err "SDDM måste stängas av innan den manuella WSL-sessionen startar."
    err "Kör en gång: sudo systemctl disable --now sddm.service"
    return 1
}

remove_old_kwin_override() {
    if [[ -f "$OLD_KWIN_DROPIN" ]]; then
        mv "$OLD_KWIN_DROPIN" "$STATE_DIR/centos10-kde6.conf.nested-backup"
    fi
    systemctl --user daemon-reload
}

repair_user_data_permissions() {
    if [[ -d "$HOME/.local" && ! -w "$HOME/.local" ]]; then
        info "Rättar ägarskapet för $HOME/.local ..."
        if ! sudo -n chown -R "$(id -u):$(id -g)" "$HOME/.local"; then
            err "$HOME/.local är inte skrivbar. Kör: sudo chown -R $USER:$USER $HOME/.local"
            return 1
        fi
    fi
}

import_environment() {
    systemctl --user unset-environment WAYLAND_SOCKET 2>/dev/null || true
    systemctl --user import-environment \
        DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
        XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
        DESKTOP_SESSION KDE_FULL_SESSION KDE_SESSION_VERSION \
        QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND PULSE_SERVER \
        2>/dev/null || true

    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd \
            DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
            XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
            DESKTOP_SESSION KDE_FULL_SESSION KDE_SESSION_VERSION \
            QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND PULSE_SERVER \
            >/dev/null 2>&1 || true
    fi
}

start_session() {
    setup_environment || return 1

    if session_running; then
        ok "Plasma Wayland kör redan."
        status_session
        return 0
    fi

    local user_systemd
    user_systemd="$(systemctl --user is-system-running 2>/dev/null || true)"
    if [[ "$user_systemd" != "running" && "$user_systemd" != "degraded" ]]; then
        err "systemd-användarsessionen är inte redo."
        err "Kontrollera att /etc/wsl.conf innehåller [boot] systemd=true och kör sedan wsl --shutdown."
        return 1
    fi

    if ! x410_reachable; then
        err "X410 svarar inte på DISPLAY=$DISPLAY."
        err "Starta X410 i Desktop-läge och försök igen."
        return 1
    fi

    stop_display_manager || return 1
    repair_user_data_permissions || return 1
    remove_old_kwin_override || return 1

    for command_name in plasmashell systemd-run; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            err "Saknar kommandot: $command_name"
            return 1
        fi
    done

    # Clear interrupted full-session attempts. KWin cannot stay up as a nested
    # compositor on this WSLg/X410 combination, so Windows/WSLg manages app
    # windows and X410 hosts the Plasma shell.
    systemctl --user stop plasma-workspace-wayland.target plasma-workspace.target \
        graphical-session.target plasma-kwin_wayland.service \
        plasma-plasmashell.service plasma-ksplash.service "$UNIT" \
        >/dev/null 2>&1 || true
    systemctl --user reset-failed plasma-kwin_wayland.service plasma-plasmashell.service \
        plasma-ksplash.service "$UNIT" \
        >/dev/null 2>&1 || true

    import_environment
    : >"$LOG_FILE"
    {
        printf 'centos10-kde6 %s\n' "$VERSION"
        printf 'started=%s\n' "$(date --iso-8601=seconds)"
        printf 'DISPLAY=%s\n' "$DISPLAY"
        printf 'WAYLAND_DISPLAY=%s\n' "$WAYLAND_DISPLAY"
        printf 'shell_platform=xcb (X410)\n'
        printf 'app_platform=wayland (WSLg)\n\n'
    } >>"$LOG_FILE"

    systemctl --user start \
        plasma-kactivitymanagerd.service \
        plasma-kglobalaccel.service \
        plasma-kcminit.service \
        plasma-kded6.service \
        >/dev/null 2>&1 || true

    info "Startar Plasma Shell i X410 och appar på WSLg/Wayland ..."
    if ! systemd-run --user \
        --unit="$UNIT" \
        --collect \
        --service-type=exec \
        --setenv="DISPLAY=$DISPLAY" \
        --setenv="WAYLAND_DISPLAY=$WAYLAND_DISPLAY" \
        --setenv=QT_QPA_PLATFORM=xcb \
        --setenv=XDG_SESSION_TYPE=wayland \
        --property=KillMode=control-group \
        --property=TimeoutStopSec=20s \
        --property="StandardOutput=append:$LOG_FILE" \
        --property="StandardError=append:$LOG_FILE" \
        /usr/bin/plasmashell --no-respawn >/dev/null; then
        err "Kunde inte skapa Plasma Shell-tjänsten."
        return 1
    fi

    local waited=0
    local stable=0
    while (( waited < 40 )); do
        if session_running; then
            ((stable++))
            if (( stable >= 8 )); then
                ok "Plasma 6 kör stabilt: skal i X410, appar på Wayland."
                status_session
                return 0
            fi
        else
            stable=0
        fi
        if systemctl --user is-failed --quiet "$UNIT" 2>/dev/null ||
           systemctl --user is-failed --quiet plasma-plasmashell.service 2>/dev/null; then
            break
        fi
        sleep 1
        ((waited++))
    done

    err "Plasma Shell blev inte redo inom 40 sekunder."
    tail -n 80 "$LOG_FILE" >&2 || true
    systemctl --user --no-pager -l status "$UNIT" plasma-kded6.service >&2 || true
    return 1
}

stop_session() {
    info "Stoppar Plasma Shell ..."
    systemctl --user stop plasma-workspace-wayland.target plasma-workspace.target \
        graphical-session.target plasma-kwin_wayland.service plasma-plasmashell.service \
        plasma-ksplash.service "$UNIT" plasma-kded6.service \
        plasma-kglobalaccel.service plasma-kactivitymanagerd.service \
        >/dev/null 2>&1 || true

    local waited=0
    while (( waited < 15 )); do
        if ! pgrep -u "$(id -u)" -x plasmashell >/dev/null 2>&1; then
            ok "Plasma är stoppat."
            return 0
        fi
        sleep 1
        ((waited++))
    done

    warn "Några Plasma-processer svarade inte; avslutar endast sessionsprocesserna."
    pkill -TERM -u "$(id -u)" -x plasmashell 2>/dev/null || true
    pkill -TERM -u "$(id -u)" -x kwin_wayland 2>/dev/null || true
    pkill -TERM -u "$(id -u)" -x Xwayland 2>/dev/null || true
    sleep 2
    pkill -KILL -u "$(id -u)" -x plasmashell 2>/dev/null || true
    pkill -KILL -u "$(id -u)" -x kwin_wayland 2>/dev/null || true
    pkill -KILL -u "$(id -u)" -x Xwayland 2>/dev/null || true
    ok "Plasma är stoppat."
}

status_session() {
    setup_environment >/dev/null 2>&1 || true

    local shell="stoppad"
    local shell_pid=""

    shell_pid="$(pgrep -u "$(id -u)" -xo plasmashell 2>/dev/null || true)"
    pgrep -u "$(id -u)" -x plasmashell >/dev/null 2>&1 && shell="kör"

    printf '\nCentOS 10 + KDE Plasma 6 / X410 + Wayland\n'
    printf '%-22s %s\n' "Distribution:" "$(. /etc/os-release; printf '%s' "$PRETTY_NAME")"
    printf '%-22s %s\n' "Plasma:" "$(plasmashell --version 2>/dev/null | head -n1 || echo okänd)"
    printf '%-22s %s\n' "Plasma Shell:" "$shell${shell_pid:+ (pid $shell_pid)}"
    printf '%-22s %s\n' "Skal-display:" "${DISPLAY:-okänd} (X410/xcb)"
    printf '%-22s %s\n' "Program-display:" "${WAYLAND_DISPLAY:-wayland-0} (WSLg/Wayland)"
    printf '%-22s %s\n' "Fönsterhantering:" "Windows DWM / WSLg"
    printf '%-22s %s\n' "KWin:" "avstängd (undviker omstartsloopen)"
    printf '%-22s %s\n' "Logg:" "$LOG_FILE"
    printf '\n'
}

doctor() {
    setup_environment || return 1

    printf '\nCentOS 10 + KDE Plasma 6 / X410 + Wayland - doctor\n'
    printf '%-26s %s\n' "WSL:" "$(grep -qi microsoft /proc/version && echo ja || echo nej)"
    printf '%-26s %s\n' "PID 1:" "$(ps -p 1 -o comm=)"
    printf '%-26s %s\n' "Användar-systemd:" "$(systemctl --user is-system-running 2>/dev/null || true)"
    printf '%-26s %s\n' "SDDM:" "$(systemctl is-active sddm.service 2>/dev/null || true) / $(systemctl is-enabled sddm.service 2>/dev/null || true)"
    printf '%-26s %s\n' "X410 DISPLAY:" "$DISPLAY"
    if x410_reachable; then
        printf '%-26s %s\n' "X410:" "nåbar"
    else
        printf '%-26s %s\n' "X410:" "INTE nåbar"
    fi
    printf '%-26s %s\n' "WSLg Wayland-socket:" "$([[ -S "$XDG_RUNTIME_DIR/wayland-0" ]] && echo nåbar || echo SAKNAS)"
    printf '%-26s %s\n' "Plasma Shell-backend:" "xcb via X410"
    printf '%-26s %s\n' "Program-backend:" "Wayland via WSLg"
    printf '%-26s %s\n' "$HOME/.local skrivbar:" "$([[ -w "$HOME/.local" ]] && echo ja || echo nej)"
    for command_name in plasmashell systemd-run; do
        if command -v "$command_name" >/dev/null 2>&1; then
            printf '%-26s %s\n' "$command_name:" "$(command -v "$command_name")"
        else
            printf '%-26s %s\n' "$command_name:" "SAKNAS"
        fi
    done
    printf '\n'
}

show_log() {
    if [[ ! -f "$LOG_FILE" ]]; then
        warn "Ingen logg finns ännu: $LOG_FILE"
        return 0
    fi
    tail -n "${LINES:-160}" "$LOG_FILE"
}

usage() {
    cat <<EOF
centos10-kde6 $VERSION

Användning:
  centos10-kde6 start
  centos10-kde6 stop
  centos10-kde6 restart
  centos10-kde6 status
  centos10-kde6 doctor
  centos10-kde6 log

Miljö:
  X410_HOST=<Windows-IP>   överstyr automatisk gateway-detektering
  LINES=300               antal loggrader för kommandot log
EOF
}

case "${1:-start}" in
    start)   start_session ;;
    stop)    stop_session ;;
    restart) stop_session; start_session ;;
    status)  status_session ;;
    doctor)  doctor ;;
    log)     show_log ;;
    -h|--help|help) usage ;;
    *) err "Okänt kommando: $1"; usage; exit 2 ;;
esac
